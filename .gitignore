/target/
**/target/
.venv/
*.frz
*.frz.json
# ...except the small, deliberately-committed round-trip fixtures.
!binfera/tests/fixtures/freeze/*.frz.json
.DS_Store
*.pdb
Cargo.lock.bak

# scripts/difftest.py's sha256-keyed freeze/-j cache; can be
# large and is trivially regenerable, never meant to be committed.
/.cache/
__pycache__/
.pytest_cache/

# `maturin develop`'s editable install compiles the extension straight into
# the source tree (binfera-python/python/binfera/); `maturin build`/
# `cibuildwheel` write wheels to dist/wheelhouse. All regenerable, none
# meant to be committed.
binfera-python/python/binfera/*.so
binfera-python/python/binfera/*.pyd
binfera-python/dist/
binfera-python/wheelhouse/

# Release video project: kept local, not part of the repository.
/video/

# Built documentation site (`zensical build`).
/site/
