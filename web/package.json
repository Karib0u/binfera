{
  "name": "binfera-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "sh scripts/build-wasm.sh",
    "test:macho": "node scripts/check-macho.mjs",
    "test:risc": "node scripts/check-risc-graph.mjs && node scripts/check-risc.mjs",
    "test:image": "node scripts/check-image.mjs",
    "test:virtualization": "node scripts/check-virtualization.mjs",
    "test:workbench": "node scripts/check-workbench.mjs",
    "test:hex": "node scripts/check-hex.mjs",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test:touch": "node scripts/check-touch.mjs",
    "test:stages": "node scripts/check-stages.mjs",
    "test:compare-report": "node scripts/check-compare-report.mjs",
    "test:layout": "node scripts/check-workspace-layout.mjs",
    "test:textdiff": "node scripts/check-textdiff.mjs",
    "test:entropy": "node scripts/check-entropy.mjs",
    "test:triage": "node scripts/check-triage.mjs",
    "test:report": "node scripts/check-report.mjs",
    "test:compare": "node scripts/check-compare.mjs",
    "test:project": "node scripts/check-project.mjs && node scripts/check-recent.mjs",
    "test:analyze": "node scripts/check-analyze.mjs && node scripts/check-resolved.mjs",
    "test:cache": "node scripts/check-result-cache.mjs",
    "test:shellcode": "node scripts/check-shellcode-input.mjs && node scripts/check-shellcode.mjs",
    "test:archive": "node scripts/check-archive.mjs",
    "test:archive-browser": "node scripts/check-archive-browser.mjs",
    "test:delivery": "node scripts/check-delivery.mjs",
    "test:prerender": "node scripts/check-prerender.mjs",
    "test:deployment": "node scripts/check-deployed-delivery.mjs",
    "test:release": "node scripts/check-release-readiness.mjs",
    "test:assets": "node scripts/check-assets.mjs",
    "test:demos": "node scripts/check-demos.mjs",
    "pack-rules": "node scripts/pack-rules.mjs",
    "pack-demos": "node scripts/pack-demos.mjs",
    "fetch-demos": "node scripts/fetch-demos.mjs",
    "capture-docs": "node scripts/capture-docs.mjs",
    "prepare-assets": "npm run build:wasm && npm run pack-rules",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/copy-installers.mjs",
    "deploy": "npm run build && wrangler deploy",
    "prepare-desktop": "sh scripts/prepare-desktop.sh",
    "dev:desktop": "vite --mode desktop",
    "dev:mock": "vite --mode mock",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@zip.js/zip.js": "^2.25.0",
    "7z-wasm": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  }
}
